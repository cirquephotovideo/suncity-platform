// Sun City Paris — schema Prisma
// Stack: PostgreSQL 16 + Prisma 5
// Régénéré en P2 depuis 0 (le schema GLD avait 105 models hors-scope).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
}

enum Locale {
  fr
  en
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WeekOfMonth {
  W1
  W2
  W3
  W4
  W5
  ALL
  ODD
  EVEN
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
  FAILED
}

enum ProductKind {
  TICKET_DAY
  TICKET_EVENING
  PASS_MULTI
  SUBSCRIPTION
  GIFT_CARD
}

enum CouponKind {
  PERCENT
  AMOUNT_CENTS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAIL
  EXPORT
  IMPORT
  PUBLISH
  UNPUBLISH
}

// ─────────────────────────────────────────────────────────
// Auth (NextAuth + 2FA)
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  role          Role      @default(EDITOR)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts       Account[]
  sessions       Session[]
  mfa            UserMfa?
  loginAttempts  LoginAttempt[]
  auditLogs      AuditLog[]
  ordersAdmin    Order[]          @relation("OrderAdmin")
  uploadedMedia  MediaAsset[]
  approvedMedia  MediaAsset[]     @relation("MediaApprovedBy")
  uploadedPhotos Photo[]          @relation("PhotoUploader")
  approvedPhotos Photo[]          @relation("PhotoApprover")
  scheduledPosts ScheduledPost[]
  contactReplies ContactMessage[] @relation("ContactRepliedBy")
  assignedTasks  Task[]           @relation("TaskAssignee")
  createdTasks   Task[]           @relation("TaskCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserMfa {
  userId        String   @id
  totpSecret    String
  recoveryCodes String[]
  enabledAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─────────────────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────────────────

model Page {
  id          String     @id @default(cuid())
  slug        String
  locale      Locale
  title       String
  excerpt     String?    @db.Text
  contentJson Json?
  contentHtml String?    @db.Text
  seoTitle    String?
  seoDesc     String?    @db.Text
  ogImageUrl  String?
  status      PageStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  blocks PageBlock[]

  @@unique([slug, locale])
  @@index([status, locale])
}

model Article {
  id            String     @id @default(cuid())
  slug          String
  locale        Locale
  title         String
  excerpt       String?    @db.Text
  contentJson   Json?
  contentHtml   String?    @db.Text
  coverImageUrl String?
  tags          String[]
  status        PageStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  authorId      String?

  @@unique([slug, locale])
  @@index([status, publishedAt])
}

// ─────────────────────────────────────────────────────────
// Lieux internes (5 zones du sauna)
// ─────────────────────────────────────────────────────────

model Location {
  id            String   @id @default(cuid())
  slug          String   @unique
  orderIndex    Int      @default(0)
  iconKey       String?
  coverImageUrl String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations LocationTranslation[]
  media        MediaAsset[]
  photos       Photo[]

  @@index([active, orderIndex])
}

model LocationTranslation {
  id         String  @id @default(cuid())
  locationId String
  locale     Locale
  title      String
  summary    String  @db.Text
  contentMd  String  @db.Text
  seoTitle   String?
  seoDesc    String? @db.Text

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, locale])
}

// ─────────────────────────────────────────────────────────
// Agenda
// ─────────────────────────────────────────────────────────

model RecurringEvent {
  id            String      @id @default(cuid())
  slug          String      @unique
  dayOfWeek     DayOfWeek
  weekOfMonth   WeekOfMonth @default(ALL)
  startTime     String
  endTime       String?
  priceLabel    String?
  hostedBy      String?
  externalUrl   String?
  coverImageUrl String?
  active        Boolean     @default(true)
  orderIndex    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  translations RecurringEventTranslation[]
  events       Event[]

  @@index([active, dayOfWeek])
}

model RecurringEventTranslation {
  id               String  @id @default(cuid())
  recurringEventId String
  locale           Locale
  title            String
  summary          String? @db.Text

  recurringEvent RecurringEvent @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)

  @@unique([recurringEventId, locale])
}

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  startsAt         DateTime
  endsAt           DateTime?
  status           EventStatus @default(PUBLISHED)
  recurringEventId String?
  coverImageUrl    String?
  externalUrl      String?
  ticketProductId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  recurring     RecurringEvent?    @relation(fields: [recurringEventId], references: [id], onDelete: SetNull)
  translations  EventTranslation[]
  media         MediaAsset[]
  photos        Photo[]
  ticketProduct Product?           @relation(fields: [ticketProductId], references: [id], onDelete: SetNull)

  @@index([startsAt, status])
}

model EventTranslation {
  id        String  @id @default(cuid())
  eventId   String
  locale    Locale
  title     String
  summary   String? @db.Text
  contentMd String? @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
}

// ─────────────────────────────────────────────────────────
// Tarifs porte (affichage)
// ─────────────────────────────────────────────────────────

model Tariff {
  id             String      @id @default(cuid())
  code           String      @unique
  priceCents     Int
  currency       String      @default("EUR")
  daysApplicable DayOfWeek[]
  conditionLabel String?
  orderIndex     Int         @default(0)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  translations TariffTranslation[]
}

model TariffTranslation {
  id       String  @id @default(cuid())
  tariffId String
  locale   Locale
  label    String
  details  String? @db.Text

  tariff Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@unique([tariffId, locale])
}

// ─────────────────────────────────────────────────────────
// Billetterie Stripe
// ─────────────────────────────────────────────────────────

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  kind             ProductKind
  active           Boolean     @default(true)
  stripeProductId  String?     @unique
  defaultVariantId String?     @unique
  coverImageUrl    String?
  redeemableFrom   DateTime?
  redeemableTo     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  translations ProductTranslation[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  events       Event[]
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  title       String
  description String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  sku           String  @unique
  label         String
  priceCents    Int
  currency      String  @default("EUR")
  stripePriceId String? @unique
  active        Boolean @default(true)
  orderIndex    Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  number                String      @unique
  email                 String
  customerName          String?
  status                OrderStatus @default(PENDING)
  totalCents            Int
  currency              String      @default("EUR")
  stripeCheckoutId      String?     @unique
  stripePaymentIntentId String?     @unique
  couponId              String?
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  adminId               String?

  items  OrderItem[]
  coupon Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  admin  User?       @relation("OrderAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  quantity       Int     @default(1)
  unitPriceCents Int
  totalCents     Int
  qrCodeToken    String? @unique

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  kind           CouponKind
  value          Int
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?
  redemptions    Int        @default(0)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]
}

// ─────────────────────────────────────────────────────────
// Newsletter (double opt-in RGPD)
// ─────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  locale           Locale           @default(fr)
  status           NewsletterStatus @default(PENDING)
  confirmToken     String           @unique
  unsubscribeToken String           @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())

  @@index([status, createdAt])
}

model NewsletterCampaign {
  id          String    @id @default(cuid())
  subject     String
  contentHtml String    @db.Text
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────
// Contact & médias
// ─────────────────────────────────────────────────────────

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  subject     String?
  body        String        @db.Text
  ip          String?
  userAgent   String?
  status      ContactStatus @default(UNREAD)
  createdAt   DateTime      @default(now())
  readAt      DateTime?
  repliedAt   DateTime?
  repliedById String?

  repliedBy User? @relation("ContactRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model MediaAsset {
  id           String      @id @default(cuid())
  key          String      @unique
  mime         String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?
  status       MediaStatus @default(PENDING)
  uploadedById String?
  eventId      String?
  locationId   String?
  createdAt    DateTime    @default(now())
  approvedAt   DateTime?
  approvedById String?

  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("MediaApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────
// Settings / Theme / Banner / Partners
// ─────────────────────────────────────────────────────────

model SiteSettings {
  id               Int      @id @default(1)
  contactPhone     String?
  contactEmail     String?
  address          String?
  rcs              String?
  openingHoursJson Json?
  socialJson       Json?
  partnersJson     Json?
  ageGateEnabled   Boolean  @default(true)
  ageGateMinAge    Int      @default(18)
  themeKey         String   @default("sun")
  defaultLocale    Locale   @default(fr)
  updatedAt        DateTime @updatedAt
}

model Theme {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  paletteJson Json
  fontDisplay String?
  fontBody    String?
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Banner {
  id        String    @id @default(cuid())
  slug      String    @unique
  position  String
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  ctaUrl    String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  translations BannerTranslation[]
}

model BannerTranslation {
  id       String  @id @default(cuid())
  bannerId String
  locale   Locale
  title    String
  body     String? @db.Text
  ctaLabel String?

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  url        String?
  logoUrl    String?
  category   String?
  orderIndex Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// Audit & email log
// ─────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String
  targetId   String?
  diffJson   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  from       String
  subject    String
  template   String?
  status     String
  providerId String?
  errorMsg   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([to, createdAt])
}

// ─────────────────────────────────────────────────────────
// V2 — Analytics, Photos modérées, Social, Gift cards, Page Builder
// ─────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  locale    String?
  referer   String?
  ua        String?
  ip        String?
  country   String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([country, createdAt])
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PhotoKind {
  EVENT
  LOCATION
  GALLERY
  PROMO
}

model Photo {
  id           String      @id @default(cuid())
  key          String      @unique
  mime         String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?
  caption      String?     @db.Text
  kind         PhotoKind   @default(GALLERY)
  status       PhotoStatus @default(PENDING)
  uploadedById String?
  approvedById String?
  approvedAt   DateTime?
  eventId      String?
  locationId   String?
  source       String? // "admin", "import-bulk", "instagram"
  externalUrl  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  uploadedBy User?     @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("PhotoApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status, kind, createdAt])
}

enum SocialChannel {
  INSTAGRAM
  FACEBOOK
  TWITTER
  TIKTOK
  LINKEDIN
  YOUTUBE
}

enum ScheduledPostStatus {
  PENDING
  PUBLISHED
  FAILED
  CANCELLED
}

model ScheduledPost {
  id          String              @id @default(cuid())
  channels    SocialChannel[]
  caption     String              @db.Text
  mediaUrls   String[]
  scheduledAt DateTime
  status      ScheduledPostStatus @default(PENDING)
  publishedAt DateTime?
  errorMsg    String?             @db.Text
  externalIds Json? // { instagram: "...", facebook: "..." }
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  authorId    String?

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id              String         @id @default(cuid())
  code            String         @unique // ex "SC-GIFT-XXXXXX"
  amountCents     Int
  currency        String         @default("EUR")
  buyerEmail      String
  buyerName       String?
  recipientEmail  String?
  recipientName   String?
  message         String?        @db.Text
  status          GiftCardStatus @default(ACTIVE)
  expiresAt       DateTime?
  redeemedAt      DateTime?
  redeemedOrderId String?
  stripeSessionId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, expiresAt])
  @@index([buyerEmail])
}

// Page Builder : sections de page composables
enum BlockKind {
  HERO_VIDEO
  HERO_IMAGE
  TEXT
  IMAGE
  CTA
  GALLERY
  EVENT_LIST
  LOCATION_LIST
  TARIFF_TABLE
  PARTNERS
  CONTACT_FORM
  NEWSLETTER_FORM
  RAW_HTML
  EMBED
}

model PageBlock {
  id        String    @id @default(cuid())
  pageId    String
  kind      BlockKind
  orderIdx  Int       @default(0)
  dataJson  Json // contenu spécifique au type de bloc
  visible   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, orderIdx])
}

// ─────────────────────────────────────────────────────────
// P9 — IA & RAG additions
// Append this block to the end of prisma/schema.prisma
// then run: npx prisma format && npx prisma validate
// ─────────────────────────────────────────────────────────

enum AiProvider {
  GEMINI
  OPENAI
  ANTHROPIC
}

enum KnowledgeStatus {
  DRAFT
  INDEXED
  ARCHIVED
}

enum KnowledgeSource {
  MANUAL
  WEB
  SCHEMA
}

model AiSetting {
  id               Int        @id @default(1)
  defaultProvider  AiProvider @default(GEMINI)
  geminiModel      String     @default("gemini-1.5-flash")
  openaiModel      String     @default("gpt-4o-mini")
  anthropicModel   String     @default("claude-3-haiku-20240307")
  dailyBudgetCents Int        @default(500)
  updatedAt        DateTime   @updatedAt
}

model KnowledgeDoc {
  id        String          @id @default(cuid())
  slug      String          @unique
  title     String
  source    KnowledgeSource @default(MANUAL)
  sourceUrl String?
  content   String          @db.Text
  status    KnowledgeStatus @default(DRAFT)
  locale    Locale          @default(fr)
  indexedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  chunks KnowledgeChunk[]

  @@index([status, locale])
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  docId     String
  orderIdx  Int
  text      String   @db.Text
  embedding String?  @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, orderIdx])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id            String       @id @default(cuid())
  title         String
  descriptionMd String?      @db.Text
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueAt         DateTime?
  assignedToId  String?
  createdById   String

  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User  @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSecret {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String    @db.Text
  description String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================================================
// INSTRUCTIONS MANUELLES — modèle User
// ==========================================================================
// Ajoutez ces deux lignes dans le bloc model User { ... } :
//
//   assignedTasks Task[] @relation("TaskAssignee")
//   createdTasks  Task[] @relation("TaskCreator")
//
// Le modèle UserMfa EXISTS déjà — NE PAS recréer.
// La relation `mfa UserMfa?` EXISTS déjà dans User — NE PAS toucher.
// ==========================================================================
